<?xml version="1.0"?>
<package format="3">
  <name>antropi_nav_demo</name>
  <version>1.0.0</version>
  <description>TurtleBot3 autonomous navigation demo with Nav2 for Antropi Robotics internship assignment</description>
  <maintainer email="bhavesh@email.com">Singam Bhavesh Reddy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>turtlebot3_navigation2</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>